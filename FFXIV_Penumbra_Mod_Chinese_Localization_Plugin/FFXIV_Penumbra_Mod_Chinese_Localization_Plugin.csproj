<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.1.8.2</Version>
    <!-- 禁用 NuGet 漏洞审计：本机到 api.nuget.org 的链路被重置，审计失败会刷 NU1900 噪声警告（与代码无关） -->
    <NuGetAudit>false</NuGetAudit>
    <!-- 抑制 MSB3277（WindowsBase 4.0/5.0 冲突）：冲突源是 WebView2 主包附带、本项目并不使用的 Wpf.dll；
         运行时只加载 CoreWebView2（Core.dll），不会触碰 Wpf，故此冲突不影响功能。 -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- 插件 ID（InternalName）= 程序集名，必须为 ASCII；显示名（Name）用中文。 -->
    <AssemblyName>FFXIV_Penumbra_Mod_Chinese_Localization_Plugin</AssemblyName>
    <!-- 不从 NuGet 包复制 pdb 调试符号（保持输出目录整洁） -->
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <!-- Manifest 字段（见 https://dalamud.dev/plugin-development/plugin-metadata）：
         必填 Name / Author / Description / Punchline；InternalName/AssemblyVersion/DalamudApiLevel 由打包器自动填。
         Punchline 为单行短摘要；Description 首行为摘要、其后为详细说明（手动换行以便安装器完整显示）。 -->
    <Author>Lexington-cv2-Lady</Author>
    <Name>FFXIV_penumbra的模组汉化插件</Name>
    <Punchline>把 Penumbra 模组的英文选项与描述批量汉化为简体中文并写回，游戏内即时生效。</Punchline>
    <Description>读取 Penumbra 模组的选项与描述，用本地词典与 AI 批量汉化为简体中文，写回 meta.json / group_*.json 后自动触发 Penumbra 重载，游戏内即时生效。纯本地翻译，无遥测。
汉化前自动备份（zip 按份数轮转），可一键还原且保留 Penumbra 的选项状态；支持 Penumbra 新旧双格式、纯中文输出、黑名单保留英文专名。
词典来源：我的翻译 / 个性翻译 / wiki 术语对照 / AI 知识库 / 单词黑名单；AI 翻译内置多家国内主流服务商（按平台自动拆批），也支持导出后交给外部 AI 翻译再汇总。
可将 Penumbra 模组的英文选项一键中文化，适合追求中文界面的玩家。</Description>
    <RepoUrl>https://github.com/Lexington-cv2-Lady/FFXIV_Penumbra_Mod_Chinese_Localization_Plugin</RepoUrl>
    <IconUrl>https://cdn.jsdmirror.com/gh/Lexington-cv2-Lady/FFXIV_Penumbra_Mod_Chinese_Localization_Plugin@main/Data/icon.png</IconUrl>
    <Tags>汉化;翻译;模组;penumbra;ffxiv;chinese;localization;中文</Tags>
    <CategoryTags>utility</CategoryTags>
    <!-- dev 插件部署目录（构建后自动复制）。用 $(APPDATA) 环境变量，避免写死个人用户名路径；
         本机若用非默认启动器目录，可在 gitignore 的 local.props 里覆盖 DevPluginDir。 -->
    <DevPluginDir Condition="'$(DevPluginDir)' == ''">$(APPDATA)\XIVLauncherCN\devPlugins\FFXIV_Penumbra_Mod_Chinese_Localization_Plugin</DevPluginDir>
  </PropertyGroup>

  <!-- 本机私有覆盖（不入库）：可在此设置 DevPluginDir 等机器相关属性 -->
  <Import Project="local.props" Condition="Exists('local.props')" />

  <ItemGroup>
    <!-- 插件图标：Dalamud 对 dev/本地插件从 <插件目录>\images\icon.png 读取（须为正方形、≤512×512）。
         放到输出目录的 images\ 子目录，DeployToDev 会连同子目录一并部署到 devPlugins。 -->
    <Content Include="..\Data\icon.png">
      <Link>images\icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- wiki 提取的 Cloudflare 验证接管：用独立 Win32 窗口承载 WebView2（CoreWebView2Controller），
         用户手动过点后插件读取 cf_clearance cookie。
         用主包（Core.dll 已内含其中）。独立的 Microsoft.Web.WebView2.Core 包在国内镜像（华为云/腾讯云）
         均未同步，故引主包；主包附带、本项目并不使用的 Wpf.dll 其 WindowsBase 冲突已用 NoWarn 抑制。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Penumbra.Api" Version="5.19.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Penumbra.Api 依赖的 Luna 程序集（NuGet 包仅发布不完整的 Luna.Core，此处引用游戏内完整版） -->
    <Reference Include="Luna">
      <HintPath>lib\Luna.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyLunaDeps" AfterTargets="Build">
    <ItemGroup>
      <_LibDeps Include="lib\Microsoft.Extensions*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibDeps)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- DependsOn 打包器：DalamudPackager 的 targets 在 SDK 末尾导入、晚于本文件执行；
       不加依赖时 DeployToDev 会先复制“上一次”生成的旧 manifest（例如 RepoUrl 不同步更新）。 -->
  <Target Name="DeployToDev" AfterTargets="Build" DependsOnTargets="CopyLunaDeps;DefaultDalamudPackagerDebug;DefaultDalamudPackagerRelease">
    <ItemGroup>
      <_DeployFiles Include="$(TargetDir)*" Exclude="$(TargetDir)*.pdb" />
      <_DeployFiles Include="$(TargetDir)*\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFiles="@(_DeployFiles->'$(DevPluginDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- 允许测试工程访问 internal 类型（如 JsonFile），用于回归测试 -->
  <ItemGroup>
    <InternalsVisibleTo Include="FFXIV_Penumbra_Mod_Chinese_Localization_Plugin.Tests" />
  </ItemGroup>

</Project>
